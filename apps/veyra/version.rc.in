#include <windows.h>
#include "veyra-resource.h"
IDI_VEYRA ICON "veyra.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @SILIVID_VERSION_RC@
 PRODUCTVERSION @SILIVID_VERSION_RC@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS @SILIVID_VERSION_RC_FLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "Silivid Video Player"
   VALUE "FileVersion", "@SILIVID_VERSION@"
   VALUE "ProductName", "Silivid"
   VALUE "ProductVersion", "@SILIVID_VERSION@"
   VALUE "OriginalFilename", "@VEYRA_RESOURCE_FILENAME@"
   VALUE "LegalCopyright", "Veyra contributors. GPL-3.0."
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
